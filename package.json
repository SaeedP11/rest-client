{
  "name": "@sp11/rest-client",
  "version": "1.0.0",
  "description": "Axios-based REST client core: tokens with refresh, typed HTTP errors, filter and pagination queries, server-sent events",
  "keywords": [
    "axios",
    "rest",
    "client",
    "crud",
    "pagination",
    "sse"
  ],
  "author": "saeedp11",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npx tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p test/tsconfig.json",
    "format": "prettier --write \"**/*.ts\""
  },
  "peerDependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "axios": "^1.7.7",
    "prettier": "^3.0.0",
    "typescript": "^5.1.3",
    "vitest": "^5.0.3"
  }
}
